# Copy to .env (or add in your host's Environment Variables settings: Hostinger, Vercel, etc.)

# Save every quote request to Supabase (table: quote_requests). Find both in
# Supabase > Project Settings > API Keys. The publishable key is safe to expose;
# never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email every quote request to you via Resend (https://resend.com). Free tier is plenty.
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@le-booth.com
# Must be on a domain you've verified in Resend
QUOTE_FROM_EMAIL=Le Booth <quotes@le-booth.com>

# Optional: also POST each lead as JSON to Zapier / Make (e.g. to log it or push it onward)
QUOTE_WEBHOOK_URL=
