# Copy to .env.local (or add in Vercel > Project > Settings > Environment Variables)

# Email every quote request to you via Resend (https://resend.com). Free tier is plenty.
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@le-booth.com
# Must be on a domain you've verified in Resend
QUOTE_FROM_EMAIL=Le Booth <quotes@le-booth.com>

# Optional: also POST each lead as JSON to Zapier / Make (e.g. to log it or push it onward)
QUOTE_WEBHOOK_URL=
